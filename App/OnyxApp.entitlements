<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>get-task-allow</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.personal-information.location</key>
    <true/>

    <!-- MapKit: public/private entitlement variants to maximize chance of tile access on jailbreak -->
    <key>com.apple.mapkit</key>
    <true/>
    <key>com.apple.MapKit.allowed</key>
    <true/>
    <key>com.apple.private.mapkit.allowed</key>
    <true/>
    <key>com.apple.developer.maps</key>
    <true/>

    <!-- Location services -->
    <key>com.apple.locationd.authorized</key>
    <true/>
    <key>com.apple.locationd.effective_bundle</key>
    <true/>
</dict>
</plist>
