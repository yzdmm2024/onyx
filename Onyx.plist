<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Mode</key>
        <string>WildCard</string>
        <key>Bundles</key>
        <array>
            <!-- 注入所有链接 UIKit 的 App（几乎所有 GUI 应用均链接 UIKit；系统守护进程不链，安全）。
                 具体对哪些 App 生效由 App 内「应用列表」勾选 + enabled 开关动态决定（见 Tweak.xm _active()）。 -->
            <string>com.apple.UIKit</string>
        </array>
    </dict>
</dict>
</plist>
