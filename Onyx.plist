<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <!-- 只注入 SpringBoard：
             - CLSimulationManager 系统级定位模拟，全局生效
             - 瓦片代拉代理（SpringBoard 是 platformized 可联网进程）
             不注入任何用户 App，避免被钉钉等反作弊扫描到异常 dylib。 -->
        <key>Executable</key>
        <string>SpringBoard</string>
    </dict>
</dict>
</plist>